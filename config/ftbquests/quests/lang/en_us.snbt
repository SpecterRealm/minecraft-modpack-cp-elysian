{
	chapter.E100000000000100.title: "Welcome",
	chapter.E100000000000200.title: "Void Camp",
	chapter.E100000000000300.title: "First Source",
	chapter.E100000000000400.title: "Grow the Garden",
	chapter.E100000000000500.title: "Spirit Labor",
	chapter.E100000000000600.title: "Dense Magic",
	chapter.E100000000000700.title: "Iron's Combat",
	chapter.E100000000000900.title: "Side Quests",
	chapter_group.E1000000000000A1.title: "Survive",
	chapter_group.E1000000000000A2.title: "Magic Literacy",
	chapter_group.E1000000000000A3.title: "Grow & Labor",
	chapter_group.E1000000000000A4.title: "Scale",
	chapter_group.E1000000000000A5.title: "Optional",
	quest.E100000000000101.quest_desc: "Module 2 · CP Elysian — Cohort CP-Verdant-S1. You stand on almost nothing.$(br2)Magic obtains everything here — not sieves, not scrap. Quests teach the path; nothing required for completion lives only in this book.",
	quest.E100000000000101.quest_subtitle: "Void underfoot — magic ahead",
	quest.E100000000000101.title: "Welcome to CP Elysian",
	quest.E100000000000103.quest_desc: "Gear = chapter start. Circle = mainline. Hexagon = chapter gate (guidance, not a hard lock). Diamond = optional.$(br2)Press B anytime. Skip freely — the pack must still be completable.",
	quest.E100000000000103.quest_subtitle: "Shapes mean things",
	quest.E100000000000103.title: "Reading the Map",
	quest.E100000000000105.quest_desc: "There are no ore veins and no Ex Deorum loop. You bootstrap with Ars, then grow bulk materials.$(br2)Dirt reward is a convenience head-start — not the only dirt in the pack.",
	quest.E100000000000105.quest_subtitle: "No ground to mine",
	quest.E100000000000105.title: "The Void Brief",
	quest.E100000000000107.quest_desc: "Rewards make life easier. Advancement-critical unlocks always have an inherent craft or world path.$(br2)Field Manual topics unlock as you learn — gray stubs mean more is coming.",
	quest.E100000000000107.quest_subtitle: "Quests never sole path",
	quest.E100000000000107.title: "Optional Guidance",
	quest.E100000000000109.quest_desc: "Claim your Field Manual. Orientation pages unlock now; the rest stay classified until matching quests or discoveries.$(br2)Next: stabilize a void foothold, then open Source.",
	quest.E100000000000109.quest_subtitle: "Orientation unlock",
	quest.E100000000000109.title: "Field Manual",
	quest.E100000000000201.quest_desc: "Stabilize with a crafting table and enough wood to think. Rewards seed the next storage lesson — they do not replace gathering.",
	quest.E100000000000201.quest_subtitle: "Craft before you cast",
	quest.E100000000000201.title: "A Surface to Stand On",
	quest.E100000000000203.quest_desc: "Series early stash is Sophisticated Storage — not Tom's. Place a chest, then upgrade when you feel the inventory pain.$(br2)Manual topic: early stash.",
	quest.E100000000000203.quest_subtitle: "Sophisticated Storage default",
	quest.E100000000000203.title: "First Stash",
	quest.E100000000000205.quest_desc: "A backpack reward saves a grind cycle so you can focus on Ars literacy next — not inventory Tetris.",
	quest.E100000000000205.quest_subtitle: "Backpack QoL",
	quest.E100000000000205.title: "Carry More",
	quest.E100000000000207.quest_desc: "Craft a Silent Gear pickaxe. Repair kit reward keeps the lesson on materials, not repair busywork.",
	quest.E100000000000207.quest_subtitle: "Series tools soft lean",
	quest.E100000000000207.title: "Silent Gear Tools",
	quest.E100000000000209.quest_desc: "Foothold ready. Next chapter teaches Ars Source — the void's real resource loop.",
	quest.E100000000000209.quest_subtitle: "Ready for Source",
	quest.E100000000000209.title: "Camp Secure",
	quest.E100000000000301.quest_desc: "Craft a Novice Spell Book. Two Source Gems as a reward skip a painful early grind so the lesson stays on casting, not gem spam.$(br2)Inherent gem path exists via expensive Ars mat crafts (KubeJS) — quests are not the only copy.",
	quest.E100000000000301.quest_subtitle: "Ars literacy begins",
	quest.E100000000000301.title: "Novice Spell Book",
	quest.E100000000000303.quest_desc: "Ars' own notebook covers glyph detail. Field Manual covers pack pacing. Lapis reward seeds magebloom / imbuement — co-bootstrap, not sole lapis.",
	quest.E100000000000303.quest_subtitle: "Vendor book for glyphs",
	quest.E100000000000303.title: "Worn Notebook",
	quest.E100000000000305.quest_desc: "Place a Source Jar. Fiber reward accelerates the renewable loop you already unlocked.",
	quest.E100000000000305.quest_subtitle: "Jars before farms",
	quest.E100000000000305.title: "Hold Source",
	quest.E100000000000307.quest_desc: "Build the Imbuement Chamber. Extra Source Gems reward the lesson without forcing a long idle wait before the gate.",
	quest.E100000000000307.quest_subtitle: "Lapis into Source Gems",
	quest.E100000000000307.title: "Imbuement Chamber",
	quest.E100000000000309.quest_desc: "You can make Source Gems. Next: Mystical Agriculture grows bulk mats — after you have a first gem copy from inherent bootstrap.",
	quest.E100000000000309.quest_subtitle: "Ready to grow",
	quest.E100000000000309.title: "Source Fluent",
	quest.E100000000000401.quest_desc: "No ProjectE here — Mystical Agriculture grows bulk raw mats. Altar first; essence reward seeds the first craft cycle.$(br2)Gem seeds need an inherent first copy (expensive Ars crafts) — never quest-only.",
	quest.E100000000000401.quest_subtitle: "MA bulk path",
	quest.E100000000000401.title: "Infusion Altar",
	quest.E100000000000403.quest_desc: "Craft pedestals for the infusion ring. Inferium seeds reward starts the farm without forcing a duplicate grind.",
	quest.E100000000000403.quest_subtitle: "Complete the ring",
	quest.E100000000000403.title: "Pedestals",
	quest.E100000000000405.quest_desc: "Plant Inferium. Fertilizer ×4 accelerates one cycle so the harvest quest teaches essence use, not waiting.",
	quest.E100000000000405.quest_subtitle: "Plant the lesson",
	quest.E100000000000405.title: "First Inferium",
	quest.E100000000000407.quest_desc: "Hold 16 Inferium Essence. More fertilizer seeds the next growth — reward convenience over replicate-the-grind.",
	quest.E100000000000407.quest_subtitle: "16 essence",
	quest.E100000000000407.title: "Essence Momentum",
	quest.E100000000000409.quest_desc: "You can grow mats. Next: Occultism spirit labor automates craft/build without PE or AE.",
	quest.E100000000000409.quest_subtitle: "Labor is next",
	quest.E100000000000409.title: "Garden Online",
	quest.E100000000000501.quest_desc: "Occultism is the preferred auto-craft / build labor path (no PE, no AE). Gold reward seeds early rituals — convenience, not the only gold.",
	quest.E100000000000501.quest_subtitle: "Preferred general labor",
	quest.E100000000000501.title: "Dictionary of Spirits",
	quest.E100000000000503.quest_desc: "Place a sacrificial bowl. Spirit Fire reward skips a fiddly early step so you learn the summon loop.",
	quest.E100000000000503.quest_subtitle: "Ritual hardware",
	quest.E100000000000503.title: "Sacrificial Bowl",
	quest.E100000000000505.quest_desc: "Complete one spirit labor ritual (checkmark until smoke-test pins a detectable proxy). Ender Chest reward seeds dimensional stash.",
	quest.E100000000000505.quest_subtitle: "Labor without PE",
	quest.E100000000000505.title: "First Familiar Help",
	quest.E100000000000507.quest_desc: "MA grows; spirits build. Late chapters (stubs): dense gardens, Iron's combat after Ars literacy.",
	quest.E100000000000507.quest_subtitle: "Mid spine complete",
	quest.E100000000000507.title: "Labor Online",
	quest.E100000000000601.quest_desc: "Stub: dense MA + spirit labor at scale. Mystical Automation niche optional. Full quests after smoke-tests.",
	quest.E100000000000601.quest_subtitle: "Late scale — stub",
	quest.E100000000000601.title: "Dense Gardens (stub)",
	quest.E100000000000701.quest_desc: "Stub: Iron's Spells armor/combat chapter — do not co-teach with day-one Ars. Placeholder only.",
	quest.E100000000000701.quest_subtitle: "After Ars literacy",
	quest.E100000000000701.title: "Wizard Robes (stub)",
	quest.E100000000000901.quest_desc: "Stub: side niches only — never co-primary with Ars→MA→Occultism.",
	quest.E100000000000901.quest_subtitle: "Theurgy · Ars Zero",
	quest.E100000000000901.title: "Optional Paths (stub)"
}
